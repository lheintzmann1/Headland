; Engine configuration file.
; Input goes through the input layer (scripts/Controls/InputLayer.cs, bindings in settings.cfg) using physical
; keys, so QWERTY and AZERTY keyboards both get WASD/ZQSD in the same place.
; ETC2/ASTC texture import is required by the universal (Intel + Apple Silicon) macOS export.

config_version=5

[application]

config/name="Headland"
config/description="Top-down farming simulation: machines, soils, weather and crops."
config/version="0.17.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="Headland"
project/solution_directory="../"

[gui]

theme/custom="res://ui/theme.tres"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=2
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.42, 0.47, 0.5, 1)

[shader_globals]

g_wetness={
"type": "float",
"value": 0.0
}
g_snow={
"type": "float",
"value": 0.0
}
g_cloud_cover={
"type": "float",
"value": 0.3
}
g_cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
g_season_green={
"type": "float",
"value": 1.0
}
g_wind={
"type": "float",
"value": 0.3
}
