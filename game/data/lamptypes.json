[
  // Kinds of lamps: the driver switches a machine's lamps of a type together, with the control the type answers to.
  // "control": "lights" (the light key steps through them: off, then each "step" on in turn, 1 headlights and tail
  // lights, 2 work lights too, and back with the light-back key; a helper driving at night lights every step; step 0
  // leaves them out of the cycle), "beacons", "turnLeft" or "turnRight" (the turn signals; the hazards light both),
  // "brake" (while the vehicle slows down), "reverse" (while it backs up), "cab" (while someone drives, dimmed by day).
  // "key": for lights, the key switching the lamps of the type alone (FS: "Light front", "Work light front"…):
  // road_lights, work_lights_front, work_lights_rear or high_beam.
  // "rotating": the beam turns round (beacons). "blinking": it flashes (turn signals).
  { "id": "head",      "name": "Headlights",        "step": 1, "key": "road_lights" },
  { "id": "tail",      "name": "Tail lights",       "step": 1, "key": "road_lights" },
  { "id": "workFront", "name": "Front work lights", "step": 2, "key": "work_lights_front" },
  { "id": "workRear",  "name": "Rear work lights",  "step": 2, "key": "work_lights_rear" },
  { "id": "highBeam",  "name": "High beams",        "step": 0, "key": "high_beam" },
  { "id": "beacon",    "name": "Beacons",           "control": "beacons", "rotating": true },
  { "id": "turnLeft",  "name": "Left turn signals", "control": "turnLeft", "blinking": true },
  { "id": "turnRight", "name": "Right turn signals", "control": "turnRight", "blinking": true },
  { "id": "brake",     "name": "Brake lights",      "control": "brake" },
  { "id": "reverse",   "name": "Reverse lights",    "control": "reverse" },
  { "id": "cab",       "name": "Cab lights",        "control": "cab" }
]
