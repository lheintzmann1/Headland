[
  // Services for machines. See farm.json for the POI layout and trade.json for triggers and actions. At a "fill"
  // trigger, "refuel" fills fuel tanks; "wash" and "repair" work at triggers of their own type, for the whole
  // machine chain parked there. Washing costs "price" for a fully dirty machine; a repair costs 1% of the machine's
  // price for each 100% of wear. "configure", at a repair trigger, changes the options of the machines parked there:
  // each option fitted costs what it costs more than the one it replaces (times "priceFactor"), and "price" for the work.
  { "id": "gas_station", "name": "Gas Station", "icon": "local_gas_station", "w": 34, "d": 30,
    "visual": { "model": "res://assets/models/buildings/gas_station.glb" },
    "colliders": [
      { "x": 11, "z": -9, "w": 9, "d": 7 },
      { "x": -8, "z": -2, "w": 1.2, "d": 0.8 },
      { "x": 2, "z": -2, "w": 1.2, "d": 0.8 },
      { "x": 13.8, "z": 8, "w": 1, "d": 2 }
    ],
    "triggers": [
      { "id": "pumps", "type": "fill", "x": -3, "z": -2, "w": 20, "d": 13 },
      { "id": "wash",  "type": "wash", "x": 8,  "z": 8,  "w": 9,  "d": 12 }
    ],
    "actions": [
      { "type": "refuel", "trigger": "pumps", "fillTypes": ["diesel"] },
      { "type": "wash", "trigger": "wash", "price": 40 }
    ] },
  { "id": "workshop", "name": "Workshop", "icon": "build", "w": 24, "d": 32,
    "visual": { "model": "res://assets/models/buildings/workshop.glb" },
    "colliders": [
      { "z": -9, "w": 18, "d": 12 }
    ],
    "triggers": [
      { "id": "bay", "type": "repair", "z": 7, "w": 18, "d": 16 }
    ],
    "actions": [
      { "type": "repair", "trigger": "bay", "openHours": [7, 20] },
      { "type": "configure", "trigger": "bay", "openHours": [7, 20], "price": 250 }
    ] }
]
