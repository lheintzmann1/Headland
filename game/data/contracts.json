[
  // Jobs the neighbors offer. A field job is done on one of their fields with a work area of type "work"
  // (cultivator, plow, seeder, spreader, sprayer, harvester, mower), and only offered when some machine does that
  // work (on the field's crop). It is offered when at least half of the field is in its "offer" state and not
  // enough of it (see "threshold" in economy.json) is in its "done" state yet.
  // A state is any of its "ground" types (grass, cultivated, seeded, stubble, plowed), any of its "crop" states
  // (none, dead, sown: a living crop at any stage, growing: not ripe yet, harvestable), any of its "weeds" (none,
  // small, grown, sprayed) and "fertilized" (true or false: since the last harvest); what's left out allows anything.
  // In "done", sown, growing and harvestable mean the job's own crop: the one ripe on the field, or for a sowing job
  // one whose sowing window is open when the job is offered.
  // "rewardPerHa" pays by the field's area, "days": [min, max] game days to finish once taken, "months" limit when
  // it is offered, and "weight" makes it come up more or less often than the other jobs that fit.
  // "deliver" on a harvest job: the crop belongs to the neighbor and at least "share" of what was harvested must be
  // tipped at the buyer named on the contract. A delivery job (no "work") asks for "amount": [min, max] units of
  // goods a buyer on the map takes ("fillTypes", default any), and pays their market price times "priceFactor".
  // "leases": machine sets a field job can be taken with, from a POI whose delivery spot leases them (the dealer).
  // An offer gets the first set that can do it (for a harvest, one whose header cuts the crop), for "feePerHa" by
  // the field's area, taken from the reward. The machines wait on the dealer's lot, implements hitched, and go back
  // when the contract ends.
  { "id": "cultivate", "name": "Cultivate", "work": "cultivator", "months": [3, 4, 7, 8, 9, 10, 11],
    "offer": { "ground": ["stubble", "grass", "seeded"], "crop": ["none", "dead"] },
    "done": { "ground": ["cultivated"] },
    "rewardPerHa": 500, "days": [3, 5],
    "leases": [ { "machines": ["tractor_125", "cultivator_3"], "feePerHa": 150 } ],
    "description": "Turn the stubble, grass or failed crop into a seedbed." },
  { "id": "plow", "name": "Plow", "work": "plow", "months": [3, 9, 10, 11],
    "offer": { "ground": ["stubble", "grass", "seeded"], "crop": ["none", "dead"] },
    "done": { "ground": ["plowed"] },
    "rewardPerHa": 800, "days": [3, 6],
    "leases": [ { "machines": ["tractor_125", "plow_5"], "feePerHa": 250 } ],
    "description": "Plow the stubble, grass or failed crop under, weeds and all." },
  { "id": "sow", "name": "Sow", "work": "seeder",
    "offer": { "ground": ["cultivated", "plowed"], "crop": ["none"] },
    "done": { "crop": ["sown"] },
    "rewardPerHa": 650, "days": [2, 4],
    "leases": [ { "machines": ["tractor_125", "seeder_3"], "feePerHa": 200 } ],
    "description": "Sow the crop asked for: with your own seed, or the seed in a leased drill." },
  { "id": "fertilize", "name": "Fertilize", "work": "spreader", "months": [3, 4, 5, 6],
    "offer": { "crop": ["growing"], "fertilized": false },
    "done": { "fertilized": true },
    "rewardPerHa": 400, "days": [2, 4],
    "leases": [ { "machines": ["tractor_95", "spreader_24"], "feePerHa": 60 } ],
    "description": "Spread fertilizer on the growing crop: your own, or what's in a leased spreader." },
  { "id": "spray", "name": "Spray", "work": "sprayer", "months": [4, 5, 6, 9, 10],
    "offer": { "weeds": ["small", "grown"] },
    "done": { "weeds": ["none", "sprayed"] },
    "rewardPerHa": 300, "days": [2, 4],
    "leases": [ { "machines": ["tractor_95", "sprayer_12"], "feePerHa": 80 } ],
    "description": "Spray the weeds before they cost the crop its yield: with your own herbicide, or what's in a leased sprayer." },
  { "id": "harvest", "name": "Harvest", "work": "harvester",
    "offer": { "crop": ["harvestable"] },
    "done": { "crop": ["none"] },
    "deliver": { "share": 0.9 },
    "rewardPerHa": 900, "days": [3, 5],
    "leases": [
      { "machines": ["combine_7", "header_grain_6", "tractor_95", "trailer_16"], "feePerHa": 350 },
      { "machines": ["combine_7", "header_corn_6", "tractor_95", "trailer_16"], "feePerHa": 350 }
    ],
    "description": "Harvest the field and tip the crop at the buyer. It is the neighbor's: the buyer pays you nothing for it." },
  { "id": "mow", "name": "Mow", "work": "mower", "months": [5, 6, 7, 8, 9],
    "offer": { "crop": ["harvestable"] },
    "done": { "crop": ["growing"] },
    "rewardPerHa": 280, "days": [2, 4],
    "leases": [ { "machines": ["tractor_95", "mower_3"], "feePerHa": 70 } ],
    "description": "Mow the meadow while the grass is ready. The grass is the neighbor's, and stays lying on the field." },
  { "id": "deliver", "name": "Deliver", "days": [6, 10], "weight": 0.6,
    "deliver": { "amount": [4000, 12000], "priceFactor": 1.3 },
    "description": "Bring goods to a buyer, who pays more than the market price for them." }
]
