// Money rules. The bank lends in steps up to the credit limit; the yearly interest is charged every day, so a
// game year (12 compressed months) costs the full rate.
{
  "loanStep": 5000,
  "creditLimit": 500000,
  "loanInterest": 0.05,
  // Per hour of work. Helpers drive in real time, so this doesn't depend on the clock speed: at ×5 an hour of
  // work is five game hours, $30 each.
  "helperWagePerHour": 150,
  // Contracts (the jobs are in contracts.json). Every midnight the neighbors post "offersPerDay" new offers while
  // fewer than "maxOffers" are on the board, each for "offerDays" days. The farm takes up to "maxActive" at a time. A
  // field job is done once "threshold" of the field is.
  "contracts": { "maxOffers": 6, "offersPerDay": 2, "offerDays": 3, "maxActive": 3, "threshold": 0.95 }
}
